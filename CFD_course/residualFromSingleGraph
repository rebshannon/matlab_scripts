%% Load .xy files
cd /projectnb/am423/rshannon/turbCav/
N = [40, 80]%, 120, 160];


for i = 1:length(N)

    dir = sprintf('icoX%0.0fRe10',N(i));
    cd(strcat(dir,'/postProcessing/singleGraphX/'));
    
    Mut1 = readmatrix("0.4/line_U.xy",'FileType','text'); % Mu = [y Ux Uy Uz]
    Mpt1 = readmatrix("0.4/line_p.xy",'FileType','text'); % Mp = [y p]

    Mut2 = readmatrix("0.5/line_U.xy",'FileType','text'); % Mu = [y Ux Uy Uz]
    Mpt2 = readmatrix("0.5/line_p.xy",'FileType','text'); % Mp = [y p]

    y = Mu(:,1);
    dUx(:,i) = Mut2(:,2) - Mut1(:,2);
    dUy(:,i) = Mut2(:,3) - Mut1(:,3);
    dp(:,i) = Mpt2(:,2) - Mpt1(:,2);

    cd ../../../../

end

